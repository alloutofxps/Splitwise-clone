{
  "name": "divvy",
  "version": "1.0.0",
  "private": true,
  "description": "Divvy — a self-hosted, invite-code based shared-expense PWA. Every feature, no paywall.",
  "scripts": {
    "predev": "node scripts/copy-ocr-assets.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-ocr-assets.mjs",
    "build": "prisma generate && prisma migrate deploy && next build",
    "prebuild:app": "node scripts/copy-ocr-assets.mjs",
    "build:app": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "pwa:check": "node scripts/pwa-check.mjs",
    "ui:check": "node scripts/ui-check.mjs"
  },
  "dependencies": {
    "@number-flow/react": "0.6.2",
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/client": "7.10.1",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@tanstack/react-query": "5.104.4",
    "@tesseract.js-data/eng": "1.0.0",
    "clsx": "2.1.1",
    "idb": "8.0.4",
    "lucide-react": "1.59.0",
    "motion": "14.4.0",
    "nanoid": "6.0.2",
    "next": "15.5.28",
    "prisma": "7.10.1",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tesseract.js": "7.0.0",
    "web-push": "3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.2",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "apca-w3": "0.1.9",
    "culori": "4.0.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "4.10.2",
    "globals": "^17.13.0",
    "pixelmatch": "8.0.0",
    "playwright": "^1.64.1",
    "pngjs": "7.0.0",
    "railway": "3.16.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "5.0.5"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "deepmerge-ts": "^8.0.2"
  }
}
