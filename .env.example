DATABASE_URL="file:./dev.db"
# Signs identity cookies. Generate your own with: openssl rand -hex 32
DIVVY_SECRET="replace-me-with-openssl-rand-hex-32"

# --- Optional -------------------------------------------------------------

# Domain passkeys belong to. Set it before anyone registers a passkey.
# DIVVY_RP_ID="divvy.example.com"

# Bearer token for an external cron calling POST /api/recurrences/run.
# The server already posts recurring expenses itself every minute.
# DIVVY_CRON_SECRET="another-long-random-string"

# How many proxies sit in front of the app and append to X-Forwarded-For.
# Railway, Fly, Render or a single nginx: 1 (the default). No proxy at all: 0.
# DIVVY_TRUSTED_PROXIES=1

# Stream every database change to S3-compatible storage (off-site backup).
# Read by the Docker image; credentials via LITESTREAM_ACCESS_KEY_ID and
# LITESTREAM_SECRET_ACCESS_KEY.
# LITESTREAM_REPLICA_URL="s3://my-bucket/divvy"
# Cloudflare R2 needs its endpoint and region in the same address:
# LITESTREAM_REPLICA_URL="s3://my-bucket/divvy?endpoint=<account-id>.r2.cloudflarestorage.com&region=auto"

# Where daily and pre-migration database snapshots go (default: backups/ next
# to the database file).
# DIVVY_BACKUP_DIR="/data/backups"

# Error alerts: every logged error is POSTed here (Slack, Discord and most
# incident tools accept the payload), at most once a minute.
# DIVVY_ALERT_WEBHOOK="https://hooks.slack.com/services/..."

# Shown on the /privacy page so people know who runs this server.
# DIVVY_CONTACT="Run by Example Ltd - privacy@example.com"

# Phone notifications. Generate with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:you@example.com"

# Run a server that serves requests but no background jobs.
# DIVVY_DISABLE_JOBS=1
